{
	"name": "obsidian-abbreviations-note",
	"version": "2.1.2",
	"description": "Abbreviations expander for Obsidian, configured in a vault note",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --outdir=.test-build --log-level=warning && node --test .test-build/*.test.js"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.2",
		"@typescript-eslint/eslint-plugin": "7.9.0",
		"@typescript-eslint/parser": "8.71.2",
		"builtin-modules": "4.0.0",
		"esbuild": "0.23.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.7.3"
	},
	"dependencies": {
		"@codemirror/view": "^6.26.3",
		"@types/codemirror": "^5.60.15",
		"codemirror": "^6.0.1",
		"reflect-metadata": "^0.2.2"
	}
}
